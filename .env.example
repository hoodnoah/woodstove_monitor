# WiFi Configuration
WIFI_SSID=your_ssid
WIFI_PASSWORD=your_password

# MQTT Configuration
MQTT_ENDPOINT=mqtt://broker.example.com
MQTT_USER=username
MQTT_PASS=password

# Build Environment (platform-specific - see SETUP.md)
# macOS: export LIBCLANG_PATH="$(brew --prefix llvm)/lib"
# Linux: export LIBCLANG_PATH=/usr/lib/llvm-14/lib
LIBCLANG_PATH=

# Optional: PKG_CONFIG_PATH for OpenSSL
# macOS: export PKG_CONFIG_PATH="$(brew --prefix openssl)/lib/pkgconfig"
PKG_CONFIG_PATH=
